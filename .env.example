# VakDab Server Environment Variables

# Google OAuth (Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget (BotFather: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Discord OAuth (Developer Portal: https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Application URL (provided by runtime or domain)
APP_URL=

# Node runtime
PORT=3000
DATA_DIR=./data
NODE_ENV=production
